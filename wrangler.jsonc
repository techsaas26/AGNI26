{
  // Cloudflare Pages. `npm run build` writes the static export to ./out; ./functions holds the one Pages Function
  // (functions/index.js: phones opening "/" are sent to /m before the desktop page loads).
  // Dashboard (Git) builds: build command `npm run build`, output directory `out`, Node 22.
  // CLI: `npx wrangler pages deploy` (reads the output directory from here). Local check: `npx wrangler pages dev`.
  // "name" must match the Pages project's name in the Cloudflare dashboard (lowercase; also the *.pages.dev subdomain).
  "name": "agni2026",
  "pages_build_output_dir": "./out",
  "compatibility_date": "2026-10-01"
}
